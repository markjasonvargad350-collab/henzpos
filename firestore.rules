rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Access model (backed by Firebase Auth):
    //   - Every visitor is signed in — customers anonymously, staff with the
    //     shared Email/Password account.
    //   - "Staff" = any signed-in user whose provider is NOT anonymous.
    // ----------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Medical Pre-Orders: customers (anonymous) may read and place orders;
    // only staff may update status/packing.
    //
    // Staff may delete, but ONLY as housekeeping: the Clear Old Records tool in
    // the Unified Database screen exports a CSV before it deletes anything, and
    // it only ever offers finished orders (Cancelled / Claimed). Nothing in the
    // customer portal can reach this — `isStaff()` excludes anonymous sessions.
    match /preOrders/{preOrderId} {
      allow read, create: if isSignedIn();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Inventory Products: anyone signed in can read stock/prices; only staff
    // may create, edit, restock, or remove products.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Sales Transactions: readable by signed-in sessions; only staff may record
    // a sale.
    //
    // `update` stays permanently closed — a recorded sale can never be ALTERED,
    // which is the property that makes the sales report trustworthy as BIR
    // paperwork. `delete` is open to staff purely so old records can be cleared
    // out once they have been exported to CSV; the housekeeping tool refuses to
    // delete anything it has not first written to a file. Removing a whole
    // receipt is visible (the report total drops); silently editing one would
    // not be, which is why only the former is permitted.
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update: if false;
      allow delete: if isStaff();
    }

    // Stock Transfers: readable by signed-in sessions; only staff may log a
    // transfer. Once logged, the audit record is immutable.
    match /stock_transfers/{transferId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // Starter Kits & Presets: readable by all signed-in sessions; only staff
    // may manage the preset catalog.
    match /preset_kits/{kitId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // System connectivity / heartbeat: readable by any signed-in session;
    // writes are staff-only.
    match /system/{systemDoc} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
  }
}
