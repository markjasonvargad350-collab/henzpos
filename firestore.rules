rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Medical Pre-Orders: Customers can submit pre-orders and track them; Staff can update status
    match /preorders/{preOrderId} {
      allow read, write: if true;
    }

    // Inventory Products: Customers can read stock/prices; Staff can manage inventory
    match /products/{productId} {
      allow read, write: if true;
    }

    // Sales Transactions and History
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Stock Transfers between branches
    match /stock_transfers/{transferId} {
      allow read, write: if true;
    }

    // Starter Kits & Presets
    match /preset_kits/{kitId} {
      allow read, write: if true;
    }

    // System connectivity and heartbeat
    match /system/{systemDoc} {
      allow read, write: if true;
    }
  }
}

